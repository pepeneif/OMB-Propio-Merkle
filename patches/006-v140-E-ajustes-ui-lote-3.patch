diff --git a/src/lib/model-picker-open.test.ts b/src/lib/model-picker-open.test.ts
new file mode 100644
index 000000000..20833c255
--- /dev/null
+++ b/src/lib/model-picker-open.test.ts
@@ -0,0 +1,35 @@
+// @vitest-environment happy-dom
+import { act, createElement } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { requestModelPicker, useModelPickerOpen } from "./model-picker-open";
+
+(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+let host: HTMLDivElement, root: Root;
+beforeEach(() => { host = document.createElement("div"); document.body.append(host); root = createRoot(host); });
+afterEach(() => { act(() => root.unmount()); host.remove(); });
+
+function Picker({ threadId, open }: { threadId: string | undefined; open: () => void }) {
+  useModelPickerOpen(threadId, open);
+  return null;
+}
+
+it("answers false when nothing holds a picker for the thread", () => {
+  expect(requestModelPicker("side")).toBe(false);
+});
+
+it("opens the mounted picker for its own thread, and leaves other threads alone", async () => {
+  const open = vi.fn();
+  await act(async () => root.render(createElement(Picker, { threadId: "side", open })));
+  expect(requestModelPicker("other")).toBe(false);
+  expect(open).not.toHaveBeenCalled();
+  expect(requestModelPicker("side")).toBe(true);
+  expect(open).toHaveBeenCalledTimes(1);
+});
+
+it("stops answering once the picker unmounts", async () => {
+  const open = vi.fn();
+  await act(async () => root.render(createElement(Picker, { threadId: "side", open })));
+  await act(async () => root.render(createElement(Picker, { threadId: undefined, open })));
+  expect(requestModelPicker("side")).toBe(false);
+});
diff --git a/src/lib/model-picker-open.ts b/src/lib/model-picker-open.ts
new file mode 100644
index 000000000..7535273e5
--- /dev/null
+++ b/src/lib/model-picker-open.ts
@@ -0,0 +1,32 @@
+import { useEffect, useRef } from "react";
+
+// The model picker belongs to the chat header (Advanced) or the bot panel (Simple), but the chat's ⋯ menu can name it:
+// a menu row that says the model's name opens that picker directly instead of sending the person to Settings. The
+// request names its thread, so a menu left over from another chat never opens this one's picker. Nothing mounted for
+// the thread answers, and the caller falls back to the plain settings link.
+const requests = new Set<(threadId: string) => boolean>();
+
+/** Opens the model picker of the chat showing this thread. Returns whether some picker took the request. */
+export function requestModelPicker(threadId: string): boolean {
+  let handled = false;
+  for (const request of Array.from(requests)) handled = request(threadId) || handled;
+  return handled;
+}
+
+/** The picker's side: opens for a request naming its thread, and answers that it did. */
+export function useModelPickerOpen(threadId: string | undefined, open: () => void): void {
+  const latest = useRef(open);
+  latest.current = open;
+  useEffect(() => {
+    if (!threadId) return;
+    const request = (target: string) => {
+      if (target !== threadId) return false;
+      latest.current();
+      return true;
+    };
+    requests.add(request);
+    return () => {
+      requests.delete(request);
+    };
+  }, [threadId]);
+}
