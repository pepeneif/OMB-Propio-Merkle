-      key: "new-thread",
-      heading: t("task.list"),
-      separatorBefore: threads.length >= 2,
-      label: t("task.newShort"),
-      icon: <SquarePen size={16} />,
-      onSelect: () => dispatch({ type: "newTask", botId: profile.id }),
