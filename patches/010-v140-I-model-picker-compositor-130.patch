@@ -0,0 +1,51 @@
+// @vitest-environment happy-dom
+// The composer's emoji button, ported from NanoBot: the picker opens above the
+// button and a chosen emoji goes to the composer through onPick.
+import { createElement } from "react";
+import { flushSync } from "react-dom";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("emoji-picker-react", () => ({
+  Theme: { AUTO: "auto", LIGHT: "light", DARK: "dark" },
+  SuggestionMode: { RECENT: "recent", FREQUENT: "frequent" },
+  default: ({ onEmojiClick }: { onEmojiClick: (data: { emoji: string }) => void }) =>
+    createElement("button", { type: "button", "data-testid": "picker", onClick: () => onEmojiClick({ emoji: "🚀" }) }, "picker"),
+}));
+
+import { ComposerEmoji } from "./ComposerEmoji";
+
+describe("the composer emoji button", () => {
+  let root: Root;
+  let container: HTMLDivElement;
+  const button = () => container.querySelector<HTMLButtonElement>(`button[aria-label="Emoji"]`);
+
+  beforeEach(() => {
+    container = document.createElement("div");
+    document.body.append(container);
+    root = createRoot(container);
+  });
+  afterEach(() => {
+    flushSync(() => root.unmount());
+    document.body.innerHTML = "";
+    vi.clearAllMocks();
+  });
+
+  it("keeps the picker closed until the button is pressed, then hands the choice to the composer", () => {
+    const onPick = vi.fn();
+    flushSync(() => root.render(createElement(ComposerEmoji, { onPick })));
+    expect(button()).not.toBeNull();
+    expect(container.querySelector('[data-testid="picker"]')).toBeNull();
+    flushSync(() => button()!.click());
+    expect(container.querySelector('[data-testid="picker"]')).not.toBeNull();
+    flushSync(() => container.querySelector<HTMLButtonElement>('[data-testid="picker"]')!.click());
+    expect(onPick).toHaveBeenCalledWith("🚀");
+  });
+
+  it("opens nothing while the composer is disabled", () => {
+    flushSync(() => root.render(createElement(ComposerEmoji, { onPick: vi.fn(), disabled: true })));
+    expect(button()!.disabled).toBe(true);
+    flushSync(() => button()!.click());
+    expect(container.querySelector('[data-testid="picker"]')).toBeNull();
+  });
+});
diff --git a/src/components/ComposerEmoji.tsx b/src/components/ComposerEmoji.tsx
new file mode 100644
index 000000000..fc9e996d9
--- /dev/null
+++ b/src/components/ComposerEmoji.tsx
@@ -0,0 +1,71 @@
+import { useEffect, useRef, useState } from "react";
+import EmojiPicker, { Theme as EmojiTheme, SuggestionMode, type EmojiClickData } from "emoji-picker-react";
+import { Smile } from "lucide-react";
+import { cn } from "@/lib/cn";
+import { t } from "@/lib/i18n";
+
+/** The composer's emoji button, ported from NanoBot (bot.merkle.space): the same
+ *  emoji-picker-react picker, anchored above the button. A click inserts the emoji
+ *  at the caret through `onPick`; the picker keeps its own recent list. Like
+ *  NanoBot, it is a desktop control and is not shown on a phone. */
+export function ComposerEmoji({ onPick, disabled, simple = false }: {
+  onPick: (emoji: string) => void;
+  disabled?: boolean;
+  simple?: boolean;
+}) {
+  const [open, setOpen] = useState(false);
+  const holderRef = useRef<HTMLDivElement>(null);
+  useEffect(() => {
+    if (!open) return;
+    const onDown = (event: MouseEvent) => {
+      if (holderRef.current?.contains(event.target as Node)) return;
+      setOpen(false);
+    };
+    const onKey = (event: KeyboardEvent) => {
+      if (event.key === "Escape") setOpen(false);
+    };
+    document.addEventListener("mousedown", onDown);
+    document.addEventListener("keydown", onKey);
+    return () => {
+      document.removeEventListener("mousedown", onDown);
+      document.removeEventListener("keydown", onKey);
+    };
+  }, [open]);
+  return (
+    <div ref={holderRef} className="relative">
+      <button
+        type="button"
+        onClick={() => setOpen((value) => !value)}
+        disabled={disabled}
+        aria-label={t("composer.emoji")}
+        title={t("composer.emoji")}
+        aria-expanded={open}
+        className={cn(
+          "flex shrink-0 items-center justify-center",
+          simple
+            ? "size-7 rounded-full bg-ink/[0.05] ring-[0.5px] ring-inset ring-ink/[0.07] text-ink-tertiary hover:bg-ink/[0.09] hover:text-ink"
+            : "size-8 rounded-full text-ink-secondary hover:bg-control hover:text-ink",
+          open && !simple && "bg-control text-ink",
+        )}
+      >
+        <Smile size={simple ? 16 : 18} />
+      </button>
+      {open && (
+        <div className="absolute bottom-full left-0 z-40 mb-2">
+          <EmojiPicker
+            width={360}
+            height={430}
+            searchDisabled={false}
+            skinTonesDisabled
+            previewConfig={{ showPreview: false }}
+            suggestedEmojisMode={SuggestionMode.RECENT}
+            lazyLoadEmojis
+            theme={EmojiTheme.AUTO}
+            onEmojiClick={(emojiData: EmojiClickData) => onPick(emojiData.emoji)}
+            customEmojis={[]}
+          />
+        </div>
+      )}
+    </div>
+  );
+}
