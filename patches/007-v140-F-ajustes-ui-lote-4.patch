diff --git a/src/styles.css b/src/styles.css
index 874d203d5..6a95d16ad 100644
--- a/src/styles.css
+++ b/src/styles.css
@@ -1115,6 +1115,13 @@
   line-height: 1.75;
   font-family: "omb-chat", var(--font-sans);
 }
+/* A markdown body makes its own line breaks (one per paragraph, plus an explicit <br>
+   for each newline inside a paragraph), so it must not inherit the user bubble's
+   white-space: pre-wrap: the renderer also emits a literal newline right after that
+   <br>, which pre-wrap would paint as a second, empty line. Plain text keeps it. */
+.chat-md {
+  white-space: normal;
+}
 .chat-md :is(strong, b) {
   font-weight: 600;
 }
